    "hono": "^4.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "playwright-core": "^1.55.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.33.1"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sifr-studio-ventures/brief.git"
  }
}
