{
  "name": "brief",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted reader and scheduler for X and LinkedIn.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
